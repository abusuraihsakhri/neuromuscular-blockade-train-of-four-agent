{
  "openapi": "3.1.0",
  "info": {
    "title": "Legacy generic-metric audit demonstration API",
    "version": "2.0.1",
    "description": "This endpoint is not clinically validated. No patient identifiers or treatment decisions. Separate educational /api/tof implementation is available through the optional package server."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8000",
      "description": "Local-only demo server"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Non-sensitive health check",
        "responses": {
          "200": {
            "description": "Healthy"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Aggregate JSON counters",
        "responses": {
          "200": {
            "description": "Public non-sensitive JSON counters"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Legacy synthetic audit (not validated)",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ],
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Unvalidated synthetic dossier"
          },
          "401": {
            "description": "Invalid key"
          },
          "503": {
            "description": "API key missing from server"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Mock demonstration response",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Deterministic mock response"
          },
          "401": {
            "description": "Invalid key"
          },
          "503": {
            "description": "API key not configured"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Access temporary HMAC audit trail",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "In-memory signed events"
          },
          "401": {
            "description": "Invalid key"
          },
          "503": {
            "description": "API key not configured"
          }
        }
      }
    }
  }
}
